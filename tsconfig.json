{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
